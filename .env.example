# ==========================================
# CONFIGURACIÓN GENERAL DEL SERVIDOR
# ==========================================
NODE_ENV=development
PORT=3000
APP_NAME="Mi Proyecto"
APP_URL=http://localhost:3000

# ==========================================
# BASE DE DATOS
# ==========================================
# Cadena de conexión completa (PostgreSQL / MySQL / MongoDB)
DATABASE_URL="postgresql://usuario:password@localhost:5432/nombre_db?schema=public"

# Parámetros individuales (en caso de requerirlo la app)
DB_HOST=localhost
DB_PORT=5432
DB_USER=usuario_local
DB_PASSWORD=password_seguro
DB_NAME=nombre_db

# ==========================================
# GOOGLE CLOUD PLATFORM (GCP)
# ==========================================
# Autenticación de GCP (Ruta al archivo JSON de la Service Account para dev local)
GOOGLE_APPLICATION_CREDENTIALS=./config/gcp-service-account.json

# Proyecto
GCP_PROJECT_ID=mi-proyecto-gcp

# Cloud Storage (GCS)
GCS_BUCKET_NAME=mi-bucket-gcs

# Pub/Sub (Opcional)
GCP_PUBSUB_TOPIC=projects/tu-gcp-project-id/topics/mi-topico

# ==========================================
# SEGURIDAD Y AUTENTICACIÓN
# ==========================================
# Claves secretas para firma de Tokens (JWT) y Sesiones
JWT_SECRET=tu_jwt_secret_aqui_clave_larga
JWT_EXPIRES_IN=1d
SESSION_SECRET=tu_session_secret_aqui

# ==========================================
# CACHÉ Y MEMORIA (Redis)
# ==========================================
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=

# ==========================================
# SERVICIOS DE CORREO / SMTP
# ==========================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=tu_usuario_smtp
SMTP_PASSWORD=tu_password_smtp
EMAIL_FROM="Soporte <no-reply@tu-dominio.com>"

# ==========================================
# API KEYS DE TERCEROS
# ==========================================
# Proveedores de Pagos / IA / Cloud Storage
OPENAI_API_KEY=sk-proj-tu_api_key_de_openai_aqui
STRIPE_SECRET_KEY=sk_test_tu_key_de_prueba_de_stripe
AWS_ACCESS_KEY_ID=tu_aws_access_key
AWS_SECRET_ACCESS_KEY=tu_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=mi-bucket-s3